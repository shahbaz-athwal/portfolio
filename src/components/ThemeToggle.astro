---
import Icon from "@/components/Icon.astro";
---

<button
  type="button"
  data-theme-toggle
  aria-label="Toggle theme"
  class="grid size-8 place-items-center rounded-full text-stone-500 transition-colors hover:bg-stone-200/70 hover:text-stone-900 dark:hover:bg-stone-800/70 dark:hover:text-stone-100"
>
  <Icon name="sun" class="hidden size-4 dark:block" />
  <Icon name="moon" class="size-4 dark:hidden" />
</button>

<script>
  const root = document.documentElement;
  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const toggle = () => {
      const dark = root.classList.toggle("dark");
      localStorage.setItem("theme", dark ? "dark" : "light");
    };
    if (document.startViewTransition) document.startViewTransition(toggle);
    else toggle();
  });
</script>
