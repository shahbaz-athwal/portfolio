---
import { Image } from "astro:assets";
import Icon from "@/components/Icon.astro";
import type { Project } from "@/data/site";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="group">
  <a
    href={project.href ?? project.code}
    target="_blank"
    rel="noopener"
    class="block overflow-hidden rounded-xl border border-stone-200 dark:border-stone-800"
  >
    <Image
      src={project.image}
      alt={project.title}
      widths={[640, 1280]}
      sizes="(min-width: 640px) 320px, 100vw"
      class="aspect-[16/9] w-full object-cover transition-transform duration-500 ease-out-soft group-hover:scale-[1.02]"
    />
  </a>
  <div class="mt-3 flex items-baseline justify-between gap-4">
    <h3 class="font-medium text-stone-900 dark:text-stone-100">{project.title}</h3>
    <div class="flex shrink-0 gap-3 text-stone-500">
      <a href={project.code} target="_blank" rel="noopener" aria-label={`${project.title} source`} class="transition-colors hover:text-stone-900 dark:hover:text-stone-100">
        <Icon name="code" />
      </a>
      {
        project.href && (
          <a href={project.href} target="_blank" rel="noopener" aria-label={`Visit ${project.title}`} class="transition-colors hover:text-stone-900 dark:hover:text-stone-100">
            <Icon name="arrow-up-right" />
          </a>
        )
      }
    </div>
  </div>
  <p class="text-sm text-stone-500">{project.description}</p>
  <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1 font-mono text-[11px] text-stone-500">
    {project.tags.map((tag) => <li>{tag}</li>)}
  </ul>
</article>
