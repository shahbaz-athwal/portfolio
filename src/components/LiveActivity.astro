---
/**
 * Live Discord presence via Lanyard (https://github.com/Phineas/lanyard).
 * Shows what's playing on Spotify and the current editor activity.
 * Vanilla TS over a WebSocket — the only client JS on the page.
 */
import { site } from "@/data/site";
---

<section data-live-activity data-user={site.discordId} hidden class="mt-16 space-y-2">
  <h2 class="flex items-center gap-2 font-mono text-xs text-stone-500">
    <span class="relative flex size-1.5">
      <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-500 opacity-60"></span>
      <span class="relative inline-flex size-1.5 rounded-full bg-emerald-500"></span>
    </span>
    Live
  </h2>

  <a data-field="spotify" hidden target="_blank" rel="noopener noreferrer" class="activity-card group">
    <img data-field="art" alt="" width="48" height="48" class="size-12 shrink-0 rounded-md bg-stone-200 object-cover dark:bg-stone-800" />
    <div class="min-w-0 flex-1">
      <p class="truncate text-sm font-medium text-stone-900 group-hover:underline dark:text-stone-100" data-field="song"></p>
      <p class="truncate text-xs text-stone-500" data-field="artist"></p>
      <div class="mt-2 flex items-center gap-2 font-mono text-[10px] text-stone-500 tabular-nums">
        <span data-field="elapsed">0:00</span>
        <div class="h-1 flex-1 overflow-hidden rounded-full bg-stone-200 dark:bg-stone-800">
          <div data-field="progress" class="h-full w-0 rounded-full bg-stone-500 transition-[width] duration-1000 ease-linear dark:bg-stone-300"></div>
        </div>
        <span data-field="total">0:00</span>
      </div>
    </div>
  </a>

  <div data-field="code" hidden class="activity-card">
    <img data-field="icon" alt="" width="48" height="48" class="size-12 shrink-0 rounded-md bg-stone-200 object-cover dark:bg-stone-800" />
    <div class="min-w-0 flex-1">
      <p class="truncate text-sm font-medium text-stone-900 dark:text-stone-100" data-field="name"></p>
      <p class="truncate text-xs text-stone-500" data-field="details"></p>
      <p class="truncate text-xs text-stone-500" data-field="state"></p>
    </div>
  </div>
</section>

<style>
  @reference "@/styles/global.css";

  .activity-card {
    @apply flex items-center gap-3 rounded-xl border border-stone-200 p-3 transition-colors dark:border-stone-800;
  }
  a.activity-card:hover {
    @apply border-stone-300 dark:border-stone-700;
  }
  .activity-card:not([hidden]) {
    animation: reveal 500ms var(--ease-out-soft) both;
  }
</style>

<script>
  type Activity = {
    name: string;
    application_id?: string;
    details?: string;
    state?: string;
    assets?: { large_image?: string; large_text?: string };
  };

  type Spotify = {
    song: string;
    artist: string;
    album: string;
    album_art_url: string;
    track_id: string;
    timestamps: { start: number; end: number };
  };

  type Presence = {
    spotify: Spotify | null;
    activities: Activity[];
  };

  const EDITORS = new Set(["Visual Studio Code", "Cursor", "Zed"]);

  const root = document.querySelector<HTMLElement>("[data-live-activity]");
  const userId = root?.dataset.user;

  let ws: WebSocket | undefined;
  let heartbeat: number | undefined;
  let reconnect: number | undefined;
  let attempt = 0;

  // Socket only while visible: an open socket blocks bfcache and keeps hidden tabs busy.
  function connect() {
    if (!root || !userId || ws) return;
    window.clearTimeout(reconnect);
    const socket = new WebSocket("wss://api.lanyard.rest/socket");
    ws = socket;

    socket.addEventListener("message", (event) => {
      if (socket !== ws) return; // a socket dropped by disconnect() can still deliver events
      const msg = JSON.parse(event.data);
      if (msg.op === 1) {
        heartbeat = window.setInterval(
          () => socket.send(JSON.stringify({ op: 3 })),
          msg.d.heartbeat_interval,
        );
        socket.send(JSON.stringify({ op: 2, d: { subscribe_to_id: userId } }));
      } else if (msg.t === "INIT_STATE") {
        // Reset only once subscribed: a server that drops right after Hello must keep backing off.
        attempt = 0;
        render(root, msg.d as Presence);
      } else if (msg.t === "PRESENCE_UPDATE") {
        render(root, msg.d as Presence);
      }
    });

    socket.addEventListener("close", () => {
      if (socket !== ws) return; // already dropped by disconnect()
      window.clearInterval(heartbeat);
      ws = undefined;
      if (document.hidden) return;
      const delay = Math.min(1000 * 2 ** attempt, 30_000);
      attempt++;
      reconnect = window.setTimeout(connect, delay);
    });
  }

  function disconnect() {
    window.clearTimeout(reconnect);
    window.clearInterval(heartbeat);
    ws?.close();
    ws = undefined;
  }

  document.addEventListener("visibilitychange", () => {
    if (document.hidden) disconnect();
    else connect();
  });
  // Back/forward cache restores skip the load path, so reconnect here too.
  window.addEventListener("pageshow", () => {
    if (!document.hidden) connect();
  });

  if (!document.hidden) connect();

  let ticker: number | undefined;

  function render(root: HTMLElement, presence: Presence) {
    const spotify = presence.spotify;
    const code = presence.activities.find((a) => EDITORS.has(a.name));

    renderSpotify(field<HTMLAnchorElement>(root, "spotify"), spotify);
    renderCode(field(root, "code"), code);
    root.hidden = !spotify && !code;
  }

  function renderSpotify(el: HTMLAnchorElement, spotify: Spotify | null) {
    window.clearInterval(ticker);
    el.hidden = !spotify;
    if (!spotify) return;

    el.href = `https://open.spotify.com/track/${spotify.track_id}`;
    const art = field<HTMLImageElement>(el, "art");
    art.src = spotify.album_art_url;
    art.alt = spotify.album;
    field(el, "song").textContent = spotify.song;
    field(el, "artist").textContent = spotify.artist.replaceAll(";", ",");

    const { start, end } = spotify.timestamps;
    field(el, "total").textContent = formatTime(end - start);
    const tick = () => {
      const elapsed = Math.min(Date.now() - start, end - start);
      field(el, "elapsed").textContent = formatTime(elapsed);
      field(el, "progress").style.width = `${(elapsed / (end - start)) * 100}%`;
    };
    tick();
    ticker = window.setInterval(tick, 1000);
  }

  function renderCode(el: HTMLElement, code: Activity | undefined) {
    el.hidden = !code;
    if (!code) return;

    const icon = field<HTMLImageElement>(el, "icon");
    const asset = code.assets?.large_image;
    icon.hidden = !asset;
    if (asset) {
      icon.src = asset.startsWith("mp:external/")
        ? `https://media.discordapp.net/external/${asset.slice(12)}`
        : `https://cdn.discordapp.com/app-assets/${code.application_id}/${asset}.png`;
      icon.alt = code.assets?.large_text ?? code.name;
    }
    field(el, "name").textContent = code.name;
    field(el, "details").textContent = code.details ?? "";
    field(el, "state").textContent = code.state ?? "";
  }

  function field<T extends HTMLElement = HTMLElement>(root: HTMLElement, name: string) {
    return root.querySelector(`[data-field="${name}"]`) as T;
  }

  function formatTime(ms: number) {
    const s = Math.max(0, Math.floor(ms / 1000));
    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
  }
</script>
