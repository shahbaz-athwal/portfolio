---
import Base from "@/layouts/Base.astro";
import { formatDate, getPosts } from "@/lib/posts";

const posts = await getPosts();
---

<Base page="blog">
  <h1 data-reveal class="text-3xl font-semibold tracking-tight text-stone-950 dark:text-stone-50">Blog</h1>

  <ul class="mt-10 space-y-1">
    {
      posts.map((post, i) => (
        <li data-reveal style={`--i: ${1 + i}`}>
          <a href={`/blog/${post.id}`} class="-mx-3 flex flex-col gap-1 rounded-lg px-3 py-3 transition-colors hover:bg-stone-100 sm:flex-row sm:items-baseline sm:justify-between dark:hover:bg-stone-900">
            <span class="text-stone-900 dark:text-stone-100">
              {post.data.title}
              {!post.data.published && <span class="ml-2 font-mono text-xs text-amber-600">draft</span>}
            </span>
            <time datetime={post.data.date.toISOString()} class="shrink-0 font-mono text-xs text-stone-500">
              {formatDate(post.data.date)}
            </time>
          </a>
        </li>
      ))
    }
  </ul>
  {posts.length === 0 && <p class="mt-10 text-stone-500">Nothing here yet.</p>}
</Base>
